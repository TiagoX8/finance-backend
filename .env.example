# Conexão com o Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance

# Chave usada para assinar os JWTs (obrigatória)
SECRET_KEY=troque-esta-chave

# Tempo de expiração do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting de autenticação (opcional)
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW=3600
